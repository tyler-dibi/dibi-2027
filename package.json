{
  "name": "carbon-design-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "npm run lint && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "npm run lint && tsc -b --noEmit",
    "new-playground": "node scripts/new-playground.mjs",
    "carbon:inventory": "node scripts/carbon-inventory.mjs",
    "workshop:branches": "node scripts/workshop-branches.mjs",
    "workshop:cards": "node scripts/workshop-cards.mjs"
  },
  "dependencies": {
    "@sage/design-tokens": "^4.35.0",
    "@sage/design-tokens-fusion": "npm:@sage/design-tokens@^17.7.0",
    "carbon-react": "^162.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.14.5"
  }
}
